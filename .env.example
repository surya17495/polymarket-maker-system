# Phase-2A KYC + L2 API credentials (Polymarket CLOB).
#
# Populate this file via `cp .env.example .env` and edit in real values from
# your Polymarket account page after you complete KYC verification. Until
# these values are set, lib/live_order_placer.py raises LiveConfigurationError
# at construction and main_live.py refuses to start the live-deploy shell.
# The lab (main_paper.py + lib/strategy_lab.py) is UNAFFECTED by .env state —
# its heuristic fill path is independent of these credentials.
#
# Source:
#   1. Polymarket UI (polymarket.com) → Account → Settings → API Keys →
#      Generate new key (L2 v2 API key).
#   2. Polymarket UI → Account → Settings → Wallets → reveal EVM private key
#      for the wallet you intend to use for the maker strategy. PRODUCTION
#      STRONGLY recommends using a dedicated proxy wallet (not the main
#      browser login wallet) so that operational compromise is bounded.
#   3. (Optional) Proxy-wallet-only flow: under account → API keys, set
#      `proxy_wallet_address` value to bind this L2 API key to a specific
#      signer-only proxy. See lib/live_order_placer.py docstring for the
#      signature_type / funder py_clob_client args (signature_type=2 with
#      Polymarket's POLY_PROXY flow on Polygon zkEVM mainnet).

# L2 API key (HMAC public key — public side of HMAC-1 challenge-response)
POLY_L2_API_KEY=
# L2 API secret (HMAC private key — used to sign CLOB-REST challenges)
POLY_L2_API_SECRET=
# L2 API passphrase (HMAC passphrase — paired with the above two)
POLY_L2_API_PASSPHRASE=
# EVM wallet private key used for EIP-712 order-placement API
POLY_EVM_WALLET_PRIV_KEY=

# Optional: native-wallet flow when POLY_PROXY_WALLET_ADDRESS is unset (signature_type==0).
# Proxy-wallet flow when POLY_PROXY_WALLET_ADDRESS is set (signature_type==2).
POLY_PROXY_WALLET_ADDRESS=
